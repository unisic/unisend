<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: allowBackup="false" does not stop device-to-device transfer, so every transfer
     excludes all of the app's files. A session and store moved to another phone would not open
     there anyway: the key that wraps them stays in this phone's Keystore. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
    <cross-platform-transfer platform="ios">
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cross-platform-transfer>
</data-extraction-rules>
